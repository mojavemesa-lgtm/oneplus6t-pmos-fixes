From 072f09f0025e1a23133a6e3d6754d2bbb78223d0 Mon Sep 17 00:00:00 2001
From: mojavemesa-lgtm <252102886+mojavemesa-lgtm@users.noreply.github.com>
Date: Sun, 25 Oct 2026 00:32:37 -0700
Subject: [PATCH 13/16] power: supply: qcom_smbx: Do not restart APSD on every
 status poll

smb_status_change_work() polls once a second. When the charger type
cannot be read yet (APSD, the automatic power source detection, has not
finished) it restarts APSD (APSD_RERUN_BIT in CMD_APSD) and polls again.
But APSD needs more than 1.3 s to complete after a rerun, so restarting
it on every 1 s poll means it never completes: usb_type stays -EAGAIN
and the input limit stays at its initial value, for minutes, on every
(re)plug or after anything that makes the chip redo detection.

It only looked fine at boot because APSD had already completed at probe
time. With the module unloaded the APSD result register went from 0x00
to 0x01 within 6 s on its own.

Count the polls without a result and only restart APSD after
APSD_WAIT_POLLS (6) of them, i.e. when it really looks stuck.

Tested on a OnePlus 6T (fajita): on a PC port the USB type is reported
as SDP at once after plugging, with the APSD result register (0x1307)
set; chargers and the power bank are recognised immediately.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/power/supply/qcom_smbx.c | 19 ++++++++++++++++---
 1 file changed, 16 insertions(+), 3 deletions(-)

diff --git a/drivers/power/supply/qcom_smbx.c b/drivers/power/supply/qcom_smbx.c
index e8a66ac35..daf6127f2 100644
--- a/drivers/power/supply/qcom_smbx.c
+++ b/drivers/power/supply/qcom_smbx.c
@@ -195,6 +195,9 @@ enum smb_generation {
 #define STAT_CFG					0x690
 #define STAT_SW_OVERRIDE_CFG_BIT			BIT(6)
 
+/* polls (about 1 s each) to wait for APSD before restarting it */
+#define APSD_WAIT_POLLS					6
+
 #define SDP_CURRENT_UA					500000
 #define CDP_CURRENT_UA					1500000
 #define DCP_CURRENT_UA					1500000
@@ -236,6 +239,7 @@ struct smb_init_register {
  * @chg_psy:		Charger power supply instance
  */
 struct smb_chip {
+	unsigned int apsd_wait;
 	struct device *dev;
 	const char *name;
 	unsigned int base;
@@ -466,13 +470,22 @@ static void smb_status_change_work(struct work_struct *work)
 	}
 
 	if (rc < 0) {
-		rc = regmap_update_bits(chip->regmap, chip->base + CMD_APSD,
-					APSD_RERUN_BIT, APSD_RERUN_BIT);
+		/*
+		 * APSD can take well over a second to finish. Restarting it
+		 * on every poll keeps it from ever completing, so only kick
+		 * it again after it has had a few seconds to run.
+		 */
+		if (++chip->apsd_wait >= APSD_WAIT_POLLS) {
+			chip->apsd_wait = 0;
+			regmap_update_bits(chip->regmap, chip->base + CMD_APSD,
+					   APSD_RERUN_BIT, APSD_RERUN_BIT);
+			dev_dbg(chip->dev, "get charger type failed, rerun apsd\n");
+		}
 		schedule_delayed_work(&chip->status_change_work,
 				      msecs_to_jiffies(1000));
-		dev_dbg(chip->dev, "get charger type failed, rerun apsd\n");
 		return;
 	}
+	chip->apsd_wait = 0;
 
 	switch (charger_type) {
 	case POWER_SUPPLY_USB_TYPE_CDP:
